date-released: 2026-09-28
license: Apache-2.0
repository-code: "https://github.com/alexisdoualle/enharmonic"
url: "https://enharmonic.tonalmap.org"
keywords:
  - pitch spelling
  - enharmonic spelling
  - music information retrieval
  - MIDI
  - line of fifths
