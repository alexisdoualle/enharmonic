  },
  "keywords": [
    "music",
    "midi",
    "pitch-spelling",
    "enharmonic",
    "music-notation"
  ],
  "author": "Alexis Doualle",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
